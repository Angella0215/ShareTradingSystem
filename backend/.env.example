# Paste the complete connection string from Neon > Connection Details (do NOT put it in the frontend)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional: enables password-reset email and Google login
EMAIL_USER=
EMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
